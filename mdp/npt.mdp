title                   = NPT equilibration
define                  = -DPOSRES

integrator              = md
dt                      = 0.002
nsteps                  = 250000     ; 500 ps

continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds

cutoff-scheme           = Verlet
nstlist                 = 20

coulombtype             = PME
rcoulomb                = 1.2

vdwtype                 = cutoff
rvdw                    = 1.2

tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1 0.1
ref_t                   = 310 310

pcoupl                  = C-rescale
pcoupltype              = isotropic
tau_p                   = 5.0
ref_p                   = 1.0
compressibility         = 4.5e-5
refcoord_scaling        = all


gen_vel                 = no

pbc                     = xyz
